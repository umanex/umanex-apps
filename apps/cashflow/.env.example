# Cashflow — environment variables
# Kopieer naar .env.local voor lokale ontwikkeling
# Voeg toe via Vercel dashboard of `vercel env add` voor deployment

# Supabase — eigen project (niet dat van RowTrack).
# Te vinden onder Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Niet in .env.local zetten: het seed-script leest e-mail en wachtwoord uit de
# omgeving van het commando zelf, zodat ze nergens op schijf belanden.
#   CASHFLOW_EMAIL=... CASHFLOW_PASSWORD=... node scripts/seed-supabase.mjs <backup.json>
