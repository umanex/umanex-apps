{
  "name": "@umanex/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pm2:start": "pm2 start ./node_modules/.bin/storybook --name storybook --interpreter none --max-memory-restart 1500M -- dev -p 6006 --ci",
    "pm2:stop": "pm2 stop storybook",
    "pm2:restart": "pm2 restart storybook",
    "pm2:logs": "pm2 logs storybook",
    "figma:check": "node scripts/figma-sync-check.mjs",
    "figma:check:selftest": "node scripts/figma-sync-selftest.mjs && node scripts/figma-sync-check.mjs",
    "geometry": "node scripts/geometry-check.mjs",
    "geometry:write": "node scripts/geometry-check.mjs --write",
    "parity": "node scripts/geometry-parity.mjs"
  },
  "exports": {
    "./lib/utils": "./lib/utils.ts",
    "./lib/focus": "./lib/focus.ts",
    "./globals.css": "./globals.css",
    "./components/ui/button": "./components/ui/button.tsx",
    "./components/ui/input": "./components/ui/input.tsx",
    "./components/ui/native-select": "./components/ui/native-select.tsx",
    "./components/ui/textarea": "./components/ui/textarea.tsx",
    "./components/ui/checkbox": "./components/ui/checkbox.tsx",
    "./components/ui/dropdown-menu": "./components/ui/dropdown-menu.tsx",
    "./components/ui/card": "./components/ui/card.tsx",
    "./components/ui/separator": "./components/ui/separator.tsx",
    "./components/ui/label": "./components/ui/label.tsx",
    "./components/ui/badge": "./components/ui/badge.tsx",
    "./components/ui/tabs": "./components/ui/tabs.tsx",
    "./components/ui/slider": "./components/ui/slider.tsx",
    "./components/ui/tooltip": "./components/ui/tooltip.tsx",
    "./components/ui/sheet": "./components/ui/sheet.tsx",
    "./components/ui/theme-toggle": "./components/ui/ThemeToggle.tsx"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@umanex/config": "workspace:*",
    "@umanex/tokens": "workspace:*",
    "autoprefixer": "^10",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^10.6.0",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vite": "^8"
