{
  "name": "cashflow",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop cashflow",
    "pm2:restart": "pm2 restart cashflow",
    "pm2:logs": "pm2 logs cashflow",
    "pm2:status": "pm2 status",
    "pm2:rebuild": "next build && pm2 restart cashflow",
    "render:screens": "tsx --tsconfig scripts/tsconfig.json scripts/render-screens.tsx",
    "render:charts": "tsx --tsconfig scripts/tsconfig.json scripts/render-charts.tsx",
    "sweep": "node scripts/dom-sweep.mjs",
    "sweep:selftest": "node scripts/dom-sweep.mjs --selftest",
    "verify:visual": "pnpm render:screens && pnpm render:charts && pnpm sweep",
    "flow": "node scripts/flow-harness.mjs",
    "flow:selftest": "node scripts/flow-harness.mjs --selftest",
    "verify:flow": "next build && node scripts/flow-harness.mjs --selftest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "@umanex/tokens": "workspace:*",
    "@umanex/ui": "workspace:*",
    "date-fns": "^3.0.0",
    "immer": "^10.0.0",
    "next": "^14",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@umanex/config": "workspace:*",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "tailwindcss": "^3",
    "tsx": "^4.23.8",
    "typescript": "^5"
  }
}
