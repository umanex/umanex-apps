#!/bin/bash
# .githooks/pre-commit.local — klant-eigen checks van umanex-apps.
#
# Waarom dit bestand bestaat en niet een blok in .githooks/pre-commit: dat bestand is
# canoniek en wordt door de umanex-os-sync overschreven. GEMETEN 2026-09-09: dit blok
# landde op main in 349c9904 (18:38) en was weg in cec5661f (19:26) — één sync-commit
# later, zonder melding. De canonieke hook roept dit bestand aan wanneer het bestaat en
# geeft `changed_apps` mee; geen enkele sync-stap raakt het (niet is_canoniek(), niet
# CANON, niet de cp-stappen).
#
# Waarschuwt, blokkeert niet: hard falen zou elke BLE-commit tegenhouden tot er hardware
# naast de laptop ligt, en dat leert vooral `--no-verify` aan.


# Toestel-signaal — raakt deze commit iets dat het browser-render-pad per constructie
#    niet kan tonen?
#
#    Waarom dit bestaat. De verify-keten van rowtrack rust op Storybook (react-native-web in
#    Chromium): dat draagt de Figma-vergelijking, de sweeps en de beeld-as. Vier soorten code
#    zijn daar onzichtbaar — een `Platform.OS === 'ios'`-tak (de browser kiest altijd de
#    andere kant), alles onder `lib/ble/` (geen Bluetooth in een browser), reanimated-animatie
#    (andere runtime, en een sweep ziet de eindtoestand) en apparaat-gedrag plus native config.
#    Geen enkele guard merkt dat, en de aanname eronder — dat Storybook rendert wat de app
#    rendert — is nooit getoetst.
#
#    Waarom een waarschuwing en geen poort: hard falen zou elke BLE-commit blokkeren tot er
#    hardware naast de laptop ligt, en dat leert vooral `--no-verify` aan. Dit meldt de SCHULD
#    (wat is er sinds de laatste toestel-ronde veranderd) op het moment dat je zo'n pad
#    aanraakt, en houdt zich verder stil. GEMETEN 2026-09-09: 70 van de 410 commits van deze
#    app raken zo'n pad, en er staat geen enkele `Toestel-ronde:`-trailer in de historie.
#
#    Registreren doe je met een trailer in de commit van de ronde, ook als je niets vond:
#      Toestel-ronde: <datum> <toestel> — <wat je bekeken hebt>
for app in $changed_apps; do
  meter="apps/$app/scripts/toestel-schuld.mjs"
  [ -f "$meter" ] || continue
  # Alleen melden wanneer déze commit zo'n pad raakt; anders is het ruis bij elke doc-fix.
  raakt="$(git diff --cached --name-only --diff-filter=ACMR -- \
    "apps/$app/lib/ble" "apps/$app/app.json" "apps/$app/eas.json" "apps/$app/ios" "apps/$app/android" \
    "apps/$app/lib/recovery-link.ts" | head -1)"
  if [ -z "$raakt" ]; then
    # Ook een Platform-vertakking, reanimated of apparaat-gedrag in een gewijzigd bronbestand telt.
    for f in $(git diff --cached --name-only --diff-filter=ACMR -- "apps/$app" | grep -E '\.(tsx?|jsx?)$' | grep -v '\.stories\.' || true); do
      git show ":$f" 2>/dev/null | grep -qE "Platform\.OS[[:space:]]*===|Platform\.select|from 'react-native-reanimated'|from 'expo-(secure-store|haptics|linking|device)'" \
        && { raakt="$f"; break; }
    done
  fi
  [ -n "$raakt" ] || continue
  if command -v node >/dev/null 2>&1; then
    regel="$(cd "apps/$app" && node scripts/toestel-schuld.mjs --kort 2>/dev/null)"
    [ -n "$regel" ] && {
      echo "⚠ $app: deze commit raakt code die Storybook per constructie niet toont ($raakt)."
      echo "  $regel"
      echo "  Volledig: (cd apps/$app && node scripts/toestel-schuld.mjs) — het blijft een meting, geen poort."
    }
  fi
done

exit 0
