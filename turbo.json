{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "NEXT_DIST_DIR"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "env": ["EXPO_PUBLIC_*"],
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
