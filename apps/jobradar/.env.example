# Mock mode — gebruik fixtures i.p.v. echte API-calls
JOBRADAR_MOCK=1

# Pad naar de SQLite database (optioneel, default: .data/jobradar.db)
# JOBRADAR_DB_PATH=.data/jobradar.db

# Adzuna API (optioneel, alleen nodig als JOBRADAR_MOCK=0)
# ADZUNA_APP_ID=your_app_id
# ADZUNA_APP_KEY=your_app_key

# KBO / BCE (FOD Economie) — bulk-drop over SFTP, "Shmb &Kbo-Bce-Webservice".
# `pnpm --filter jobradar kbo:sync` spiegelt de extracts naar .data/kbo.db; het
# Prospects-tabblad leest daaruit. KBO is géén leadbron: leads komen uit de vacaturedata
# (bron `vacatures`).
#
# Let op: JOBRADAR_MOCK raakt alleen nog Adzuna. Hier stond eerder een KBO_API_KEY met de
# belofte dat hij een bron uit mock-mode haalde; die variabele werd door geen enkele regel
# code gelezen. Weg, in plaats van een sleutel die niets doet.
#
# Eén van beide: KBO_SFTP_PASSWORD óf KBO_SFTP_KEY_PATH.
# KBO_SFTP_HOST=
# KBO_SFTP_PORT=22
# KBO_SFTP_USER=
# KBO_SFTP_PASSWORD=
# KBO_SFTP_KEY_PATH=
# KBO_SFTP_PATH=
# KBO_DATA_DIR=.data/kbo

# Setup:
# 1. cp .env.example .env.local
# 2. pnpm --filter jobradar dev   (start de app op http://localhost:3003)
