# Mock mode — gebruik fixtures i.p.v. echte API-calls
JOBRADAR_MOCK=1

# Pad naar de SQLite database (optioneel, default: .data/jobradar.db)
# JOBRADAR_DB_PATH=.data/jobradar.db

# Adzuna API (optioneel, alleen nodig als JOBRADAR_MOCK=0)
# ADZUNA_APP_ID=your_app_id
# ADZUNA_APP_KEY=your_app_key

# KBO — de live-bron bestaat nog NIET. Zet je deze key, dan valt de bron uit mock-mode en
# levert hij nul leads mét een waarschuwing in sourceStatuses. Laat hem leeg tot de echte
# bron er is; bedrijfsleads komen intussen uit de vacaturedata (bron `vacatures`).
# KBO_API_KEY=

# NBB Balanscentrale (CBSO) — het personeelsbestand, rubriek 9087. Zonder deze key levert de
# bron nul rijen mét een waarschuwing; hij gooit niet. GEMETEN 2026-08-26: ook de testomgeving
# eist een key (401 zonder, 401 met een verzonnen waarde). Een UAT-key is gratis en vraagt geen
# contract — registreer op https://developer.uat2.cbso.nbb.be/ en abonneer op het product
# "Authentic Data Query". Toets hem daarna met scripts/nbb-probe.ts.
# NBB_CBSO_KEY=
# NBB_CBSO_OMGEVING=uat        # 'uat' (default) of 'productie' — de key verschilt per omgeving

# Brave Search — het webadres voor de 94% van de KBO-kandidaten die er geen heeft. Zonder deze
# key wordt er niet gezocht en blijft de knop "zoek website" op het prospect-scherm zonder
# resultaat. Gratis binnen het maandelijkse krediet voor dit volume.
# BRAVE_API_KEY=

# Setup:
# 1. cp .env.example .env.local
# 2. pnpm --filter jobradar dev   (start de app op http://localhost:3003)
